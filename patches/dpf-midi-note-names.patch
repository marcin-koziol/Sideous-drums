+        xml += "<MIDINameDocument>\n";
+        xml += "  <Author/>\n";
+        xml += "  <MasterDeviceNames>\n";
+        xml += "    <Manufacturer>" DISTRHO_PLUGIN_BRAND "</Manufacturer>\n";
+        xml += "    <Model>" DISTRHO_PLUGIN_NAME "</Model>\n";
+        xml += "    <CustomDeviceMode Name=\"Default\">\n";
+        xml += "      <ChannelNameSetAssignments>\n";
+        for (int c = 1; c <= 16; ++c)
+            xml += "        <ChannelNameSetAssign Channel=\"" + String(c) + "\" NameSet=\"Notes\"/>\n";
+        xml += "      </ChannelNameSetAssignments>\n";
+        xml += "    </CustomDeviceMode>\n";
+        xml += "    <ChannelNameSet Name=\"Notes\">\n";
+        xml += "      <AvailableForChannels>\n";
+        for (int c = 1; c <= 16; ++c)
+            xml += "        <AvailableChannel Channel=\"" + String(c) + "\" Available=\"true\"/>\n";
+        xml += "      </AvailableForChannels>\n";
+        xml += "      <UsesNoteNameList Name=\"Notes\"/>\n";
+        xml += "    </ChannelNameSet>\n";
+        xml += "    <NoteNameList Name=\"Notes\">\n";
+
+        String name;
+        for (int note = 0; note < 128; ++note)
+        {
+            name = "";
+            if (fPlugin.getMidiNoteName(static_cast<uint8_t>(note), name) && name.length() > 0)
+                xml += "      <Note Number=\"" + String(note) + "\" Name=\"" + lv2_midnam_xml_escape(name) + "\"/>\n";
+        }
+
+        xml += "    </NoteNameList>\n";
+        xml += "  </MasterDeviceNames>\n";
+        xml += "</MIDINameDocument>\n";
+
+        return strdup(xml.buffer());
+    }
+
+    char* lv2_midnam_model() const
+    {
+        char buf[128];
+        std::snprintf(buf, sizeof(buf), "%s:%p", DISTRHO_PLUGIN_NAME, (const void*)this);
+        buf[sizeof(buf)-1] = '\0';
+        return strdup(buf);
+    }
+
+    static String lv2_midnam_xml_escape(const String& s)
+    {
+        String out;
+        for (const char* c = s.buffer(); *c != '\0'; ++c)
+        {
+            switch (*c)
+            {
+            case '&':  out += "&amp;";  break;
+            case '<':  out += "&lt;";   break;
+            case '>':  out += "&gt;";   break;
+            case '"':  out += "&quot;"; break;
+            default:   out += String(*c); break;
+            }
+        }
+        return out;
+    }
