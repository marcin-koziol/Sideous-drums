+static char* lv2_midnam_get_document(LV2_Handle instance)
+{
+    return instancePtr->lv2_midnam_document();
+}
+
+static char* lv2_midnam_get_model(LV2_Handle instance)
+{
+    return instancePtr->lv2_midnam_model();
+}
+
+static void lv2_midnam_free(char* const value)
+{
+    std::free(value);
+}
+#endif // DISTRHO_PLUGIN_WANT_MIDI_INPUT
